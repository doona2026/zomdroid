<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Steam can return workshop manifests/chunks from dynamic CDN domains, including
      providers outside steamcontent.com (for example clngaa.com and pphimalayanrt.com).
      This matches WorkshopAndroidDownloader's CDN compatibility mode. Workshop requests do
      not send Steam cookies or Authorization headers to these public CDN endpoints.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
