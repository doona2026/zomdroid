<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/workshop_installed_section"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/workshop_installed_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/workshop_shared_section"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/workshop_library_mode_group"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workshop_library_mode_installed"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/workshop_library_mode_installed" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/workshop_library_mode_shared"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/workshop_library_mode_shared" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/workshop_library_shared_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/workshop_library_note"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <Button
                android:id="@+id/workshop_library_cleanup"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/workshop_library_cleanup" />
            <LinearLayout
                android:id="@+id/workshop_library_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
