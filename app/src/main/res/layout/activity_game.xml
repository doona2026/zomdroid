<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/game_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.zomdroid.input.GameInputView
            android:id="@+id/game_sv"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.zomdroid.input.InputControlsView
            android:id="@+id/input_controls_v"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/game_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:background="@drawable/toolbar_gradient">

            <TextView
                android:id="@+id/game_drawer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/game_menu_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_drawer_instance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/game_edit_controls_row"
                    style="@style/GameMenuRow"
                    android:contentDescription="@string/game_menu_edit_controls"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/GameMenuIcon"
                        android:src="@drawable/mt_icons_controls"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/GameMenuRowText"
                        android:text="@string/game_menu_edit_controls" />
                </LinearLayout>

                <View
                    style="@style/GameMenuDivider" />

                <LinearLayout
                    android:id="@+id/game_touch_controls_row"
                    style="@style/GameMenuSwitchRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/GameMenuIcon"
                        android:src="@drawable/mt_icon_controller"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/GameMenuRowText"
                        android:text="@string/game_menu_touch_controls" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/game_touch_controls_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/game_vibrate_row"
                    style="@style/GameMenuSwitchRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/GameMenuIcon"
                        android:src="@drawable/mt_icon_vibration"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/GameMenuRowText"
                        android:text="@string/game_menu_vibrate" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/game_vibrate_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <View
                    style="@style/GameMenuDivider" />

                <LinearLayout
                    android:id="@+id/game_quick_save_row"
                    style="@style/GameMenuRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/GameMenuIcon"
                        android:src="@drawable/mt_icon_save"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/GameMenuRowText"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:text="@string/game_menu_quick_save" />

                        <TextView
                            android:id="@+id/game_quick_save_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/game_return_launcher_row"
                    style="@style/GameMenuRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/GameMenuIcon"
                        android:src="@drawable/mt_icon_home"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/GameMenuRowText"
                        android:text="@string/game_menu_return_launcher" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/game_exit_row"
                    style="@style/GameMenuRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/GameMenuIcon"
                        android:src="@drawable/mt_icon_exit"
                        android:tint="@color/md_theme_error"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/GameMenuRowText"
                        android:text="@string/game_menu_exit"
                        android:textColor="@color/md_theme_error" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
