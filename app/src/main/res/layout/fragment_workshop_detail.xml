<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <ImageView android:id="@+id/workshop_detail_image" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="centerCrop" android:contentDescription="@string/workshop_cover" />
        <TextView android:id="@+id/workshop_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:id="@+id/workshop_detail_author" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/workshop_detail_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
        <TextView android:id="@+id/workshop_detail_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/workshop_detail_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/workshop_detail_open_steam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_open_steam" />
            <Button android:id="@+id/workshop_detail_download" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download" />
        </LinearLayout>
        <Button android:id="@+id/workshop_detail_download_dependencies" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workshop_download_dependencies" android:visibility="gone" />
        <TextView android:id="@+id/workshop_detail_changes_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/workshop_change_notes" android:textStyle="bold" />
        <TextView android:id="@+id/workshop_detail_changes" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/workshop_detail_dependencies_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/workshop_dependencies" android:textStyle="bold" />
        <LinearLayout android:id="@+id/workshop_detail_dependencies" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/workshop_detail_comments_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/workshop_comments" android:textStyle="bold" />
        <LinearLayout android:id="@+id/workshop_detail_comments" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/workshop_detail_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" />
    </LinearLayout>
</ScrollView>
