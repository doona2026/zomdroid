<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workshop_account_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/workshop_account_note"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <EditText
            android:id="@+id/workshop_account_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/workshop_account_username"
            android:inputType="textEmailAddress" />
        <EditText
            android:id="@+id/workshop_account_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/workshop_account_password"
            android:inputType="textPassword" />
        <Button
            android:id="@+id/workshop_account_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workshop_account_sign_in" />
        <TextView
            android:id="@+id/workshop_account_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <LinearLayout
            android:id="@+id/workshop_account_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layoutAnimation="@anim/workshop_content_layout" />
    </LinearLayout>
</ScrollView>
