<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/workshop_search" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/workshop_search_hint" android:singleLine="true" />
        <Button android:id="@+id/workshop_search_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_search" />
    </LinearLayout>
    <Spinner android:id="@+id/workshop_sort" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/workshop_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textSize="13sp" />
    <ProgressBar android:id="@+id/workshop_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/workshop_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/workshop_previous" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_previous" />
        <TextView android:id="@+id/workshop_page" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" />
        <Button android:id="@+id/workshop_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_next" />
    </LinearLayout>
</LinearLayout>
