<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/workshop_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView
            android:id="@+id/workshop_task_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <ProgressBar
            android:id="@+id/workshop_task_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100" />
        <TextView
            android:id="@+id/workshop_task_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/workshop_task_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="6"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <LinearLayout
            android:id="@+id/workshop_task_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/workshop_task_pause"
                style="@style/AppTheme.ImageButton"
                android:contentDescription="@string/workshop_download_pause"
                android:src="@drawable/mt_icon_pause"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/workshop_task_resume"
                style="@style/AppTheme.ImageButton"
                android:contentDescription="@string/workshop_download_resume"
                android:src="@drawable/mt_icon_play"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/workshop_task_retry"
                style="@style/AppTheme.ImageButton"
                android:contentDescription="@string/workshop_download_retry"
                android:src="@drawable/mt_icon_refresh"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/workshop_task_cancel"
                style="@style/AppTheme.ImageButton"
                android:contentDescription="@string/workshop_download_cancel"
                android:src="@drawable/mt_icon_close"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/workshop_task_install"
                style="@style/AppTheme.ImageButton"
                android:contentDescription="@string/workshop_download_install"
                android:src="@drawable/ic_download"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/workshop_task_fallback"
                style="@style/AppTheme.ImageButton"
                android:contentDescription="@string/workshop_download_fallback"
                android:src="@drawable/ic_workshop_download"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/workshop_task_delete"
                style="@style/AppTheme.ImageButton"
                android:contentDescription="@string/workshop_download_delete"
                android:src="@drawable/mt_icon_delete" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
