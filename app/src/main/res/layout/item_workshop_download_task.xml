<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/workshop_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView
            android:id="@+id/workshop_task_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <ProgressBar
            android:id="@+id/workshop_task_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100" />
        <TextView
            android:id="@+id/workshop_task_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/workshop_task_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="6"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button android:id="@+id/workshop_task_pause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download_pause" />
            <Button android:id="@+id/workshop_task_resume" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download_resume" />
            <Button android:id="@+id/workshop_task_retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download_retry" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/workshop_task_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download_cancel" />
            <Button android:id="@+id/workshop_task_delete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download_delete" />
            <Button android:id="@+id/workshop_task_install" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download_install" />
            <Button android:id="@+id/workshop_task_fallback" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workshop_download_fallback" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
